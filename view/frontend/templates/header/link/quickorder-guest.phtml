declare(strict_types=1);

use Blackbird\QuickOrderHyvaCompatibility\ViewModel\QuickOrderConfig;
use Hyva\Theme\Block\SortableItem;
use Magento\Framework\Escaper;

/**
 * Header customer menu link for visitors: shown only when guests may use the Quick Order page
 *
 * @var SortableItem $block
 * @var Escaper $escaper
 */

/** @var QuickOrderConfig|null $quickOrderConfig */
$quickOrderConfig = $block->getData('quickorder_config');
$label = $block->getLabel();
$path = $block->getPath();
?>
<?php if ($quickOrderConfig && $quickOrderConfig->isGuestAllowed() && $label && $path): ?>
    <a id="<?= $escaper->escapeHtmlAttr($block->getNameInLayout()) ?>"
       class="block px-4 py-2 lg:px-5 lg:py-2 hover:bg-gray-100"
       href="<?= $escaper->escapeUrl($block->getUrl($path)) ?>"
       title="<?= $escaper->escapeHtmlAttr($label) ?>"
    >
        <?= $escaper->escapeHtml($label) ?>
    </a>
<?php endif; ?>
